# Copia este archivo como .env y ajusta los valores. No subas .env a git.
# Todos los parámetros calibrables viven aquí; ninguno está escrito en el código.

# Divergencia y debate
SIMILARITY_THRESHOLD=0.75
MAX_DEBATE_ROUNDS=2

# Ollama (agentes locales y embeddings)
OLLAMA_BASE_URL=http://localhost:11434
# Tiempo máximo (s) de cada llamada a Ollama; sin límite, un Ollama colgado detiene la cola
OLLAMA_TIMEOUT_S=300
EXTRACTOR_MODEL=qwen2.5:7b
CLASIFICADOR_MODEL=qwen2.5:7b
MODELADOR_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Crítico: ollama | anthropic | openai (anthropic y openai requieren instalar su paquete)
CRITICO_PROVIDER=ollama
CRITICO_MODEL=qwen2.5:7b
CRITICO_API_KEY=

# Revisor del contexto (ADR 0022): ficha del contexto y triaje de requisitos
REVISOR_MODEL=qwen2.5:7b

# Cada cuenta puede elegir proveedor y modelo por agente en Configuración (ADR 0021).
# Sus claves de API se guardan cifradas con esta clave (Fernet). Vacía: se crea una en
# CLAVE_CIFRADO_PATH. Si varias máquinas usan la misma base (Atlas), pon aquí la misma
# clave en todas. Se genera con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO=
CLAVE_CIFRADO_PATH=data/clave_cifrado.key

# Reproducibilidad de los LLM
LLM_TEMPERATURE=0
LLM_SEED=42

# Validación humana (ADR 0017): si_hay_arbitraje (solo cuando los agentes no llegaron
# a consenso; lo demás se aprueba solo y queda editable) | siempre | nunca
VALIDACION_HUMANA=si_hay_arbitraje

# Reglas del Crítico (v1, provisionales)
SIGNIFICADO_MAX_PALABRAS=12

# NLP
SPACY_MODEL=es_core_news_sm

# MongoDB (si no responde, se usa el respaldo JSON en data/resultados/)
# Solo en este .env de la raíz: si backend/.env o una variable del sistema define
# MONGO_URI, le gana a esta. GET /conexion dice a cuál se conectó y de dónde salió.
# Atlas (la contraseña, codificada para URL, solo en tu .env; con Atlas, MONGO_TIMEOUT_MS=10000):
# MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tesis
MONGO_TIMEOUT_MS=1500

# Checkpoints de LangGraph para reanudar grafos pausados en validación
CHECKPOINT_PATH=data/checkpoints.sqlite
RESULTADOS_DIR=data/resultados
CATALOGOS_DIR=data/catalogos

# Cuentas: el código de seguridad (registro, restablecer la contraseña) va por correo.
# Sin SMTP_HOST el correo no se envía y el backend escribe el código en su consola
# (útil en desarrollo). Gmail: smtp.gmail.com, puerto 587, starttls y una «contraseña
# de aplicación» de la cuenta (no la contraseña normal).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=
SMTP_SEGURIDAD=starttls
CODIGO_MINUTOS=15
CODIGO_INTENTOS=5
CODIGO_REENVIO_S=60
# true: además de la contraseña, pide un código por correo cada vez que se entra
AUTH_CODIGO_AL_ENTRAR=false
SESION_DIAS=7
# true si el backend se sirve por HTTPS (la cookie de sesión solo viaja cifrada)
SESION_COOKIE_SEGURA=false

# API: intervalo (s) con que /eventos envía mensajes nuevos a la sandbox
SSE_INTERVALO_S=0.3

# Orígenes que pueden llamar a la API (la interfaz Dudamel), separados por coma, y
# además los que cumplan la expresión (por omisión, cualquier puerto de localhost).
# Para abrir la interfaz desde otra máquina, agrega aquí su origen.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGENES_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?

# Documentos: tamaño máximo de un PDF o .txt cargado
DOCUMENTO_MAX_MB=10

# Comparación entre requisitos (módulo exploratorio, ADR 0012)
COMPARADOR_MODEL=qwen2.5:7b
COMPARACION_RELACION_UMBRAL=0.60
COMPARACION_DUPLICADO_UMBRAL=0.92
COMPARACION_MAX_PARES=60

# Evaluación contra el corpus (ADR 0014): línea base de un solo agente
AGENTE_UNICO_MODEL=qwen2.5:7b
CORPUS_DIR=data/corpus

# Calibración (ADR 0013): rejilla del análisis de sensibilidad (no cambia el umbral)
CALIBRACION_DESDE=0.50
CALIBRACION_HASTA=0.95
CALIBRACION_PASO=0.05
